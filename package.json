{
  "name": "navihub",
  "version": "0.1.0",
  "description": "NaviHUB — personal local-only media hub (anime, VN, games, movies, TV)",
  "main": "./out/main/index.js",
  "author": "xamir",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "pack:linux": "npm run build && electron-builder --linux dir",
    "dist:win": "bash scripts/dist-win.sh",
    "export:library": "ELECTRON_RUN_AS_NODE=1 electron scripts/export-library.cjs",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "db:generate": "drizzle-kit generate",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@anthropic-ai/vertex-sdk": "^0.19.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.12.0",
    "better-sqlite3": "^11.8.1",
    "drizzle-orm": "^0.38.3",
    "kuromoji": "^0.1.2",
    "music-metadata": "^11.13.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/vt323": "^5.2.7",
    "@tanstack/react-query": "^5.62.7",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.12",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^4.3.4",
    "adm-zip": "^0.5.18",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.1",
    "electron": "^31.7.6",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
