{
  "name": "navihub",
  "version": "0.2.0",
  "description": "NaviHUB — personal local-only media hub (anime, VN, games, movies, TV)",
  "//desktopName": "Linux window association (WM_CLASS) — pairs with linux.syncDesktopName in electron-builder.yml. NOT productName, which must stay out of this file so app.getName() remains 'navihub' and userData keeps pointing at ~/.config/navihub.",
  "desktopName": "navihub.desktop",
  "main": "./out/main/index.js",
  "author": "xamir",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "pack:linux": "npm run build && electron-builder --linux dir",
    "dist:win": "bash scripts/dist-win.sh",
    "export:library": "ELECTRON_RUN_AS_NODE=1 electron scripts/export-library.cjs",
    "install:desktop": "bash scripts/install-desktop.sh",
    "db:generate": "drizzle-kit generate",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:renderer-tests": "tsc --noEmit -p tsconfig.renderer-tests.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:renderer-tests",
    "test:native": "node scripts/run-electron-node.cjs scripts/native-smoke.cjs",
    "test:main": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "test:renderer": "node node_modules/vitest/vitest.mjs run --config vitest.renderer.config.ts",
    "test": "npm run test:native && npm run test:main && npm run test:renderer",
    "db:query": "ELECTRON_RUN_AS_NODE=1 electron scripts/db.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@anthropic-ai/vertex-sdk": "^0.19.0",
    "@google/genai": "^2.12.0",
    "archiver": "^7.0.1",
    "better-sqlite3": "13.0.3",
    "electron-updater": "^6.8.9",
    "kuromoji": "^0.1.2",
    "music-metadata": "^11.13.0",
    "seek-bzip": "^2.0.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/noto-serif-jp": "^5.3.0",
    "@fontsource/vt323": "^5.2.7",
    "@tanstack/react-query": "^5.62.7",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^6.0.4",
    "@types/better-sqlite3": "^7.6.12",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^4.3.4",
    "adm-zip": "^0.5.18",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.10.3",
    "drizzle-kit": "^0.30.1",
    "drizzle-orm": "^0.38.3",
    "electron": "44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
