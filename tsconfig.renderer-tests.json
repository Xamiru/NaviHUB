{
  "extends": "./tsconfig.web.json",
  "compilerOptions": {
    "composite": false,
    "incremental": true,
    "tsBuildInfoFile": "./tsconfig.renderer-tests.tsbuildinfo",
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": [
    "src/renderer/**/*",
    "src/preload/index.d.ts",
    "src/shared/**/*",
    "tests/renderer/**/*.ts",
    "tests/renderer/**/*.tsx",
    "vitest.renderer.config.ts"
  ]
}
