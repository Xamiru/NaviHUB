    }
   }
  },
  {
   "date": null,
   "quote": {
    "id": "q17",
    "text": "The Assembly of experts met the following morning and after a long session elected Ḵāmenaʾī as Khomeini’s successor by a majority of sixty votes out of seventy-four.",
    "lang": "en",
    "cite": {
     "source": "iranica-arjomand-constitution-of-the-islamic-republic",
     "loc": {
      "section": "CONSTITUTION OF THE ISLAMIC REPUBLIC",
